{
  "name": "rocha",
  "version": "2.5.11",
  "description": "Blazing-fast native Rust orchestrator for Mocha test suites",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "rocha": "./bin/rocha"
  },
  "scripts": {
    "postinstall": "node scripts/install-binary.js",
    "test": "node --test harness/test/*.test.js"
  },
  "keywords": [
    "mocha",
    "test-runner",
    "runner",
    "typescript",
    "rust",
    "fast",
    "testing",
    "oxc"
  ],
  "author": "rogue-striker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rogue-striker/rocha.git"
  },
  "bugs": {
    "url": "https://github.com/Rogue-striker/rocha/issues"
  },
  "homepage": "https://github.com/Rogue-striker/rocha#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/rocha",
    "index.js",
    "index.d.ts",
    "harness/bin",
    "harness/bridge",
    "harness/src",
    "loader/*.cjs",
    "loader/*.mjs",
    "loader/package.json",
    "scripts/install-binary.js",
    "scripts/checksums.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "mocha": "^11.8.0",
    "mocha-junit-reporter": "^2.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
